# Generated and local workspace files. A .pubignore replaces .gitignore during
# publishing, so keep these rules here as well.
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history/
.idea/
.svn/
**/.dart_tool/
**/build/
**/coverage/
**/doc/api/
**/pubspec.lock
**/*.iml
**/*.ipr
**/*.iws
**/.flutter-plugins-dependencies

# The published example targets web. Native runner projects stay in the
# repository but are not needed to understand or run the Dart example code.
example/**/.gitignore
example/**/.metadata
example/**/analysis_options.yaml
example/**/android/
example/**/ios/
example/**/linux/
example/**/macos/
example/**/windows/
example/**/test/
example/**/lib/temp.dart
